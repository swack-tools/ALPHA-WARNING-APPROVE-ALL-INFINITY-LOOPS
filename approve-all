REPLY_RELAY = ("I can't carry messages between sessions. Do it yourself: find the session with ListAgents and "
               "use SendMessage (load them with ToolSearch if deferred), or start a session for it, then continue.")
REPLY_RECOMMENDED = "Yes, go with your recommendation."
REPLY_DEFAULT = "Go with what you think is best and keep going. Don't wait for me on this."
