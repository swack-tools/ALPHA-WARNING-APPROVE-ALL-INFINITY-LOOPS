# Copy this to .env next to the approve-all script. Hooks don't inherit your shell, so settings go here.

# Anthropic API key for the reviewer. Leave it empty to run on the rules alone.
ANTHROPIC_API_KEY=

# Everything below is optional. The values shown are the defaults.

# The model that reviews each decision, and how hard it thinks.
# APPROVE_ALL_MODEL=claude-opus-5-5
# APPROVE_ALL_EFFORT=medium

# Reviews stop at this estimated spend, in US dollars, and the rules take over.
# APPROVE_ALL_BUDGET_USD=150

# Seconds a dialog stays up.
# APPROVE_ALL_ANSWER_WAIT=3600

# Hand a session back to you after this many auto-replies since you last wrote,
# or this many turns in a row with no work done.
# APPROVE_ALL_MAX_REPLIES=25
# APPROVE_ALL_MAX_IDLE=3

# Which sessions to answer. Scripted runs (claude -p, the SDK) are left alone.
# APPROVE_ALL_ENTRYPOINTS=claude-desktop,cli

# Tools that post to a thread you read, comma separated. A question posted with one counts as the session asking you.
# APPROVE_ALL_THREAD_TOOLS=
