ENV_LINE = re.compile(r"\s*(?:export\s+)?([A-Za-z_]\w*)\s*=(.*)")


def read_env_file(path):
    """Read KEY=value lines and skip the rest. A bad file means no settings, never a stuck session."""
    try:
        text = Path(path).read_text(encoding="utf-8-sig", errors="ignore")
    except OSError:
        return {}
    values = {}
    for line in text.splitlines():
        match = ENV_LINE.fullmatch(line)
        if not match:
            continue
        value = match[2].strip()
        if value[:1] in ('"', "'") and value[0] in value[1:]:
            value = value[1:].split(value[0], 1)[0]
        else:
            value = value.split(" #", 1)[0].strip()
        values[match[1]] = value
    return values


# Hooks don't inherit your shell, so settings live in a file. It isn't exported, so nothing we run sees the key.
ENV_FILE = read_env_file(Path(__file__).resolve().with_name(".env"))


def setting(name, default=""):
    return os.environ.get(name) or ENV_FILE.get(name) or default


def number(name, default):
    """A numeric setting, or the default if it isn't one: a typo must not take the hook down."""
    try:
        return type(default)(setting(name, default))
    except ValueError:
        return default


