def log(**entry):
    """Never raises: this runs inside the hook's last-resort except."""
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%S"), **entry}, default=str) + "\n")
    except Exception:
        pass


def session_title(event):
    host = os.environ.get("CLAUDE_CODE_HOST_SESSION_ID")
    for path in glob.glob(str(DESKTOP / f"*/*/{host}.json")) if host else []:
        try:
            return json.loads(Path(path).read_text()).get("title") or host
        except (ValueError, OSError, AttributeError):
            pass
    return os.path.basename(event.get("cwd") or "") or "A session"


def open_session():
    host = os.environ.get("CLAUDE_CODE_HOST_SESSION_ID")
    if host:
        try:
            subprocess.run(["open", f"claude://claude.ai/epitaxy/{host}"], capture_output=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass


def queued_since(path, start):
    """Did a message reach the session after start? It can't be read until this hook returns."""
    if not path:
        return False
    try:
        with open(path, "rb") as f:
            f.seek(start)
            return b'"enqueue"' in f.read()
    except OSError:
        return False


def run_dialog(script, args, abandoned):
    """Show a dialog until it's answered or abandoned. Returns the text, or None."""
    proc = subprocess.Popen(["osascript", "-e", script, "--", *args], text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    signal.signal(signal.SIGTERM, lambda *_: (proc.kill(), os._exit(0)))  # don't leave a dead dialog on screen
    while proc.poll() is None:
        if abandoned():
            proc.kill()
            return None
        time.sleep(0.5)
    output = proc.stdout.read().strip()
    return output if proc.returncode == 0 and output else None


def ask_you(event, reason, ask, answers, can_type=True):
    """Put the question in a dialog and wait. Returns the text to send, or None to leave it with the session."""
    if not shutil.which("osascript"):  # dialogs are macOS only
        return None
    try:
        return show_dialog(event, reason, ask, answers, can_type)
    except Exception as e:
        log(event="error", error=f"dialog failed: {e!r}"[:400])
        return None


def show_dialog(event, reason, ask, answers, can_type):
    path = event.get("transcript_path")
    start = os.path.getsize(path) if path and os.path.exists(path) else 0
    deadline = time.time() + ANSWER_WAIT

    def abandoned():
        return time.time() > deadline or queued_since(path, start)

    choices = {" ".join(label.split())[:120]: text for label, text in answers}
    labels = [*choices, *([TYPE_ANSWER] if can_type else []), OPEN_SESSION]
    prompt = f"{reason}\n\n{' '.join(ask.split())[-300:]}"
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "dialog.lock", "w") as lock:  # one at a time, or they stack up unreadably
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if abandoned():
                    return None
                time.sleep(1)
        picked = run_dialog(CHOOSE_SCRIPT, [f"approve-all: {session_title(event)}"[:80], prompt, *labels], abandoned)
        if picked == OPEN_SESSION:
            open_session()
            return None
        if picked == TYPE_ANSWER:
            return run_dialog(TYPE_SCRIPT, [prompt], abandoned)
        return choices.get(picked)


def suggested_answers(turn, verdict, ask):
    """What the dialog offers, as (label, text to send)."""
    buttons = [b for b in (turn["wrap"] or {}).get("actions") or [] if b.get("action") not in NOT_ANSWERABLE]
    answers = [(b.get("label") or b.get("action", "").replace("_", " "), button_reply(b, ask)) for b in buttons]
    if not answers and verdict:
        if verdict.get("text"):
            answers.append((verdict["text"], verdict["text"]))
        answers += [(choice, choice) for choice in verdict.get("choices") or []]
    if not answers:
        generic = ANSWERS_DONE if blocked_by(ask) in ("secret", "hands-on") else ANSWERS_GENERIC
        answers = [(answer, answer) for answer in generic]
    return answers[:6]


def blocked_by(text):
    for name, pattern in NEVER.items():
        if re.search(pattern, text, FLAGS):
            return name
    return None


# --- transcripts -------------------------------------------------------------

def read_tail(path, size=4_000_000):
    """The transcript's last rows. Empty if it can't be read, and bad rows are skipped."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            start = max(f.tell() - size, 0)
            f.seek(start)
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError as e:
        log(event="error", error=f"can't read transcript: {e!r}"[:400])
        return []
    rows = []
    for line in lines[1:] if start else lines:
        try:
            row = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def blocks(row):
    message = row.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    if not isinstance(content, list):
        return []
    return [b for b in content if isinstance(b, dict) and isinstance(b.get("text", ""), str)
            and isinstance(b.get("name", ""), str)]


def row_text(row):
    return "\n".join(b.get("text", "") for b in blocks(row) if b.get("type") == "text")


def read_turn(rows):
    """Summarize the session's latest turn and the auto-replies that led to it."""
    said, post, wrap, tools, tag = "", "", None, [], None
    seen_end = counted = False  # counted: reached a tag or your own message, so the loop counters are known
    for row in reversed(rows):
        kind = row.get("type")
        if row.get("isSidechain") or kind not in ("user", "assistant", "attachment"):
            continue
        if kind == "assistant":
            for b in reversed(blocks(row)):
                if b.get("type") == "text" and b.get("text", "").strip() and not said:
                    said = b["text"]
                elif b.get("type") == "tool_use":
                    name, data = b.get("name", ""), b.get("input")
                    data = data if isinstance(data, dict) else {}
                    tools.append(name)
                    if name.endswith("__wrap_up") and wrap is None:
                        wrap = data
                    elif name in THREAD_POSTS and not post and data.get("visibility") != "sent_to_shared_agent":
                        post = data.get("text") or data.get("message") or ""
            seen_end = True
            continue
        if any(b.get("type") == "tool_result" for b in blocks(row)):
            continue
        text = json.dumps(row.get("attachment")) if kind == "attachment" else row_text(row)
        match = TAG.search(text)
        if match:
            tag = (int(match[1]), int(match[2]), match[3])
            counted = True
            break
        if kind == "user" and not row.get("isMeta") and text.strip():
            counted = True
            break
    return {"answerable": seen_end, "said": said, "post": post, "wrap": wrap, "tools": tools, "tag": tag,
            "counted": counted}


def read_stopped(path, size=4_000_000):
    """A stopped session's rows and turn, looking further back if the usual window doesn't reach the loop counters."""
    rows = read_tail(path, size)
    turn = read_turn(rows)
    if rows and not turn["counted"]:
        rows = read_tail(path, FAR_BACK)
        turn = read_turn(rows)
    return rows, turn


def is_human(row):
    return (row.get("type") == "user" and not row.get("isMeta") and not row.get("isSidechain")
            and not any(b.get("type") == "tool_result" for b in blocks(row)) and row_text(row).strip())


def recent_activity(rows, limit=12000):
    lines, size = [], 0
    for row in reversed(rows):
        found = []
        if is_human(row):
            found.append(f"developer: {row_text(row)[:4000]}")
        elif row.get("type") == "assistant" and not row.get("isSidechain"):
            for b in reversed(blocks(row)):
                if b.get("type") == "text" and b.get("text", "").strip():
                    found.append(f"session: {b['text'][:4000]}")
                elif b.get("type") == "tool_use":
                    found.append(f"session ran {b.get('name')}: {json.dumps(b.get('input'))[:300]}")
        for line in found:
            size += len(line)
            if size > limit:
                return "\n".join(reversed(lines))
            lines.append(line)
    return "\n".join(reversed(lines))


def build_prompt(ask, options, rows, cwd):
    first = next((row_text(r)[:2000] for r in rows if is_human(r)), "(not available)")
    listed = "\n".join(f"{i}: {option}" for i, option in enumerate(options)) or "(none, answer in words)"
    return (f"Project folder: {cwd}\n\n"
            f"<first_message_from_developer>\n{first}\n</first_message_from_developer>\n\n"
            f"<recent_session_activity>\n{recent_activity(rows)}\n</recent_session_activity>\n\n"
            f"<open_question>\n{ask}\n</open_question>\n\n"
            f"<options>\n{listed}\n</options>")


def api_key():
    # Its own files, not settings.json: an API key in env there would bill every session to it.
    if ENV_FILE.get("ANTHROPIC_API_KEY"):
        return ENV_FILE["ANTHROPIC_API_KEY"]
    try:
        key = KEY_FILE.read_text().strip()
    except (OSError, ValueError):
        key = ""
    return key or os.environ.get("ANTHROPIC_API_KEY", "").strip()


def spent():
    """Dollars so far. Bad lines are skipped. A ledger we can't read or write counts as over budget: no cap, no reviews."""
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with SPEND.open("a+", encoding="utf-8", errors="ignore") as f:
            f.seek(0)
            lines = f.read().splitlines()
    except OSError:
        return float("inf")
    total = 0.0
    for line in lines:
        try:
            cost = float(json.loads(line)["cost"])
        except (ValueError, KeyError, TypeError, RecursionError):
            continue
        if 0 < cost < float("inf"):
            total += cost
    return total


def can_review():
    return bool(api_key()) and spent() < BUDGET


def check_ledger_writes():
    """Raises if the ledger won't take a write. Opening it isn't proof: a full disk opens fine. Blank lines are skipped."""
    with SPEND.open("a") as f:
        f.write("\n")


def record_spend(usage):
    input_price, output_price = PRICES.get(MODEL, PRICES["claude-opus-5-5"])
    cost = (usage.input_tokens * input_price + usage.output_tokens * output_price) / 1_000_000
    STATE.mkdir(parents=True, exist_ok=True)
    with SPEND.open("a") as f:
        f.write(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%S"), "model": MODEL, "cost": cost,
                            "input": usage.input_tokens, "output": usage.output_tokens}) + "\n")


def ask_model(prompt):
    """Return the model's verdict, or None on any failure so the caller falls back to the rules."""
    try:
        check_ledger_writes()  # before paying: a review we can't record would slip past the budget cap
        import anthropic  # slow to load, and only this path needs it
        client = anthropic.Anthropic(api_key=api_key(), timeout=35.0, max_retries=1)
        fallback = {"betas": ["server-side-fallback-2026-07-01"], "fallbacks": "default"} if MODEL in REFUSAL_FALLBACK else {}
        response = client.beta.messages.create(
            model=MODEL,
            max_tokens=16000,
            system=REVIEWER,
            output_config={"effort": EFFORT, "format": {"type": "json_schema", "schema": VERDICT}},
            messages=[{"role": "user", "content": prompt}],
            **fallback,
        )
        record_spend(response.usage)
        if response.stop_reason != "end_turn":
            raise ValueError(f"model stopped with {response.stop_reason}")
        verdict = json.loads(next(b.text for b in response.content if b.type == "text"))
        for field, kind in (("action", str), ("option_index", int), ("message", str), ("reason", str)):
            if not isinstance(verdict.get(field), kind):
                raise ValueError(f"verdict has a bad {field}")
        verdict["choices"] = [c for c in verdict.get("choices") or [] if isinstance(c, str)]
        return verdict
    except Exception as e:
        log(event="error", error=f"review failed: {e!r}"[:400])
        return None


def button_reply(button, ask):
    if button.get("message"):
        return button["message"]
    if button.get("action"):
        return f"Yes, go ahead: {button['action'].replace('_', ' ')}."
    return f'To "{ask}": {button.get("label")}'


def find_ask(turn, loose=False):
    """The question the turn leaves open. loose also catches what only a reviewer can rule out."""
    wrap = turn["wrap"] or {}
    if wrap.get("ask"):
        actions = wrap.get("actions") or []
        return None if actions and actions[0].get("action") in NOT_ANSWERABLE else wrap["ask"]
    if turn["wrap"] is not None and not loose:
        return None  # a wrap-up with no question is the session saying nothing is pending
    for text in (turn["said"], turn["post"]):
        # Only the last paragraph: earlier ones can quote a question that isn't being asked.
        window = text[-600:] if loose else re.split(r"\n\s*\n", text.strip())[-1][-600:]
        if text and NEEDS_YOU.search(window):
            return text[-600:].strip()
    return None


def rule_reply(turn, ask):
    actions = (turn["wrap"] or {}).get("actions") or []
    if actions:
        return button_reply(actions[0], ask)
    if RELAY.search(ask):
        return REPLY_RELAY
    if RECOMMENDS.search(ask) or RECOMMENDS.search(turn["said"] or ""):
        return REPLY_RECOMMENDED
    return REPLY_DEFAULT


def review_turn(turn, ask, rows, cwd):
    """Ask the model what the developer would want. None means use the rules instead."""
    if not can_review():
        return None
    buttons = (turn["wrap"] or {}).get("actions") or []
    labels = [b.get("message") or b.get("label") or b.get("action", "") for b in buttons]
    verdict = ask_model(build_prompt(ask, labels, rows, cwd))
    if not verdict or verdict.get("action") not in ("nothing_pending", "reply", "leave_for_user"):
        return None
    if verdict["action"] == "reply":
        index = verdict.get("option_index", -1)
        if buttons and 0 <= index < len(buttons):
            verdict["text"] = button_reply(buttons[index], ask)
        elif not buttons and verdict.get("message", "").strip():
            verdict["text"] = verdict["message"].strip()
        else:
            return None
    return verdict


def ask_hash(ask):
    return hashlib.sha1(re.sub(r"\W+", " ", ask.lower()).encode()).hexdigest()[:8]


def decide(turn, rows=(), cwd=""):
    """Return None when nothing is being asked, else {ask, reply} or {ask, reason, answers} to leave it for you."""
    if not turn["answerable"]:
        return None
    ask = find_ask(turn, loose=can_review())
    if not ask:
        return None
    verdict = review_turn(turn, ask, rows, cwd)

    def for_you(reason):
        return {"ask": ask, "reason": reason, "answers": suggested_answers(turn, verdict, ask)}

    if verdict and verdict["action"] == "nothing_pending":
        return None
    if verdict and verdict["action"] == "leave_for_user":
        return for_you(verdict.get("reason") or "the reviewer left this for you")
    if verdict:
        reply = verdict["text"]
    else:
        ask = find_ask(turn)
        if not ask:
            return None
        reply = rule_reply(turn, ask)

    # After the model on purpose: it reads untrusted text, so it never gets to lift these.
    guard = blocked_by(f"{ask}\n{reply}")
    if guard:
        return for_you(guard)
    if not turn["counted"]:
        return for_you("too much has happened since the last reply to count replies")

    n, idle, last_id = turn["tag"] or (0, 0, "")
    ask_id = ask_hash(ask)
    worked = any(not t.startswith(NOT_WORK) for t in turn["tools"])
    idle = 0 if worked else idle + 1
    if ask_id == last_id:
        return for_you("asked again after being answered")
    if n >= MAX_REPLIES:
        return for_you(f"hit {MAX_REPLIES} replies since you last wrote")
    if idle >= MAX_IDLE:
        return for_you(f"{idle} turns with no work done")
    return {"ask": ask, "reply": f"[approve-all n={n + 1} idle={idle} id={ask_id} | {LABEL}]\n{reply}",
            "why": verdict.get("reason") if verdict else None}


# --- hook --------------------------------------------------------------------

def on_stop(event):
    path = event.get("transcript_path")
    rows, turn = read_stopped(path) if path and os.path.exists(path) else ([], None)
    if not rows:  # the loop limits are counted from the transcript, so without one there's no safe reply
        return None
    if not turn["said"] and event.get("last_assistant_message"):
        turn.update(said=event["last_assistant_message"], answerable=True)
    decision = decide(turn, rows, event.get("cwd") or "")
    if not decision:
        return None
    if "reason" in decision:
        # A secret typed here would land in the transcript, so that one goes through the session.
        answer = ask_you(event, decision["reason"], decision["ask"], decision.get("answers") or [],
                         can_type=blocked_by(decision["ask"]) != "secret")
        log(event="stop", action="you answered" if answer else "left for you", session=event.get("session_id"),
            cwd=event.get("cwd"), reason=decision["reason"], ask=decision["ask"][:300], reply=answer)
        if not answer:
            return None
        return {"decision": "block", "reason": f"[approve-all n=0 idle=0 id={ask_hash(decision['ask'])} | {PICKED}]\n{answer}"}
    log(event="stop", action="replied", session=event.get("session_id"), cwd=event.get("cwd"),
        ask=decision["ask"][:300], reply=decision["reply"][:300], why=decision.get("why"))
    return {"decision": "block", "reason": decision["reply"]}


def event_rows(event):
    path = event.get("transcript_path")
    return read_tail(path) if path and os.path.exists(path) else []


def pick_answer(question, rows, cwd):
    """Return (answer, reason): the option to take, or no answer and why it's left for you."""
    options = question.get("options") or []
    labels = [o["label"] for o in options]
    verdict = None
    if options and not question.get("multiSelect") and can_review():
        verdict = ask_model(build_prompt(question.get("question", ""), labels, rows, cwd))
    if verdict and verdict.get("action") == "leave_for_user":
        return "", verdict.get("reason") or "the reviewer left this for you"
    index = verdict.get("option_index", -1) if verdict and verdict.get("action") == "reply" else -1
    if 0 <= index < len(labels):
        return labels[index], None
    picks = [label for label in labels if MARKED.search(label)]
    if not question.get("multiSelect"):
        picks = picks[:1]
    picks = picks or [label for label in labels if "not recommended" not in label.lower()][:1] or labels[:1]
    return ", ".join(picks), None if picks else "question has no options"


def on_ask(event):
    data = event.get("tool_input") or {}
    questions = data.get("questions") or []
    reason = blocked_by(json.dumps(questions)) or (None if questions else "question has no options")
    answers = {}
    if not reason:
        rows, cwd = event_rows(event), event.get("cwd") or ""
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            picked = list(pool.map(lambda q: pick_answer(q, rows, cwd), questions))
        reason = next((why for _, why in picked if why), None)
        answers = {q.get("question", ""): answer for q, (answer, _) in zip(questions, picked)}
    if reason:
        only = questions[0] if len(questions) == 1 and not questions[0].get("multiSelect") else {}
        labels = [(o["label"], o["label"]) for o in only.get("options") or []]
        answer = ask_you(event, reason, only.get("question", "This session has questions for you."), labels,
                         can_type=False)
        if not answer:
            log(event="ask", action="left for you", session=event.get("session_id"), cwd=event.get("cwd"),
                reason=reason)
            return None
        answers = {only["question"]: answer}
    log(event="ask", action="replied", session=event.get("session_id"), cwd=event.get("cwd"), answers=answers)
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow",
                                   "permissionDecisionReason": "approve-all took the recommended option",
                                   "updatedInput": {**data, "answers": answers}}}


def shortened(detail):
    if len(detail) <= REVIEW_LIMIT:
        return detail
    half = REVIEW_LIMIT // 2
    return f"{detail[:half]}\n[{len(detail) - REVIEW_LIMIT} characters not shown]\n{detail[-half:]}"


def on_permission(event):
    tool = event.get("tool_name", "")
    if tool == "AskUserQuestion":
        return None
    detail = json.dumps(event.get("tool_input") or {})
    reason = blocked_by(detail)
    why = None
    if not reason and can_review():
        ask = f"The session wants to use {tool} with this input, and that needs permission: {shortened(detail)}"
        verdict = ask_model(build_prompt(ask, ["Allow it"], event_rows(event), event.get("cwd") or ""))
        if verdict and verdict.get("action") == "leave_for_user":
            reason = verdict.get("reason") or "the reviewer left this for you"
        why = verdict.get("reason") if verdict else None
    if reason:
        answer = ask_you(event, reason, f"{tool}: {detail}", [("Allow", "Allow"), ("Deny", "Deny")], can_type=False)
        log(event="permission", action=f"you chose {answer}" if answer else "left for you",
            session=event.get("session_id"), cwd=event.get("cwd"), tool=tool, reason=reason, detail=detail[:300])
        if answer == "Deny":
            return {"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {
                "behavior": "deny", "message": "The user denied this in a dialog."}}}
        if not answer:
            return None
    else:
        log(event="permission", action="allowed", session=event.get("session_id"), cwd=event.get("cwd"),
            tool=tool, detail=detail[:300], why=why)
    return {"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {"behavior": "allow"}}}


HANDLERS = {"Stop": on_stop, "PreToolUse": on_ask, "PermissionRequest": on_permission}


def cmd_hook(_):
    # A crash here must never get in a session's way: log it and let the session stop as usual.
    try:
        event = json.load(sys.stdin)
        if PAUSED.exists() or "*" not in ENTRYPOINTS and os.environ.get("CLAUDE_CODE_ENTRYPOINT") not in ENTRYPOINTS:
            return
        handler = HANDLERS.get(event.get("hook_event_name"))
        output = handler(event) if handler else None
        if output:
            print(json.dumps(output))
    except Exception as e:
        log(event="error", error=repr(e))


# --- install -----------------------------------------------------------------

def is_ours(hook):
    return isinstance(hook, dict) and bool(OURS.search(str(hook.get("command", ""))))


def hooks_in(group):
    hooks = group.get("hooks") if isinstance(group, dict) else None
    return hooks if isinstance(hooks, list) else []


def load_settings():
    """The settings, or exit. Anything we can't understand, we must not overwrite."""
    try:
        settings = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    except (OSError, ValueError) as e:
        sys.exit(f"Can't read {SETTINGS}: {e}\nFix it and try again. Nothing was changed.")
    hooks = settings.get("hooks", {}) if isinstance(settings, dict) else None
    if not isinstance(hooks, dict) or not all(isinstance(hooks.get(name, []), list)
                                              for name in ("Stop", "PreToolUse", "PermissionRequest")):
        sys.exit(f"{SETTINGS} isn't shaped like Claude Code settings.\nFix it and try again. Nothing was changed.")
    return settings


def save_settings(settings):
    target = SETTINGS.resolve()  # a symlinked settings.json stays a symlink
    target.parent.mkdir(parents=True, exist_ok=True)
    temp = target.with_suffix(".approve-all.tmp")
    temp.write_text(json.dumps(settings, indent=2) + "\n")
    if target.exists():
        shutil.copymode(target, temp)
    temp.replace(target)


def strip_ours(settings):
    hooks = settings.get("hooks", {})
    for name in ("Stop", "PreToolUse", "PermissionRequest"):
        kept = []
        for group in hooks.get(name, []):
            theirs = [h for h in hooks_in(group) if not is_ours(h)]
            if len(theirs) == len(hooks_in(group)):
                kept.append(group)  # none of ours in it: leave it exactly as it is
            elif theirs:
                kept.append({**group, "hooks": theirs})
        if kept:
            hooks[name] = kept
        else:
            hooks.pop(name, None)
    if "hooks" in settings and not hooks:
        del settings["hooks"]


def cmd_install(_):
    uv = shutil.which("uv")
    if not uv:
        sys.exit("uv not found, and the hooks need it. Install it from https://docs.astral.sh/uv/ and try again.")
    # Claude Code takes exit code 2 as "block this", and that's what a moved script or a uv failure gives. Never block.
    command = shlex.join([uv, "run", "--quiet", "--script", str(Path(__file__).resolve()), "hook"]) + " || true"
    settings = load_settings()
    backup = SETTINGS.with_name(SETTINGS.name + ".approve-all.bak")
    if SETTINGS.exists() and not backup.exists():  # keep the one from before the first install
        shutil.copy2(SETTINGS, backup)
    strip_ours(settings)
    hooks = settings.setdefault("hooks", {})
    entry = {"hooks": [{"type": "command", "command": command, "timeout": max(ANSWER_WAIT, 0) + 120}]}
    hooks.setdefault("Stop", []).append(entry)
    hooks.setdefault("PreToolUse", []).append({"matcher": "AskUserQuestion", **entry})
    hooks.setdefault("PermissionRequest", []).append(entry)
    save_settings(settings)
    print(f"Installed in {SETTINGS}. Sessions already running may need restarting to pick it up.")


def cmd_uninstall(_):
    settings = load_settings()
    strip_ours(settings)
    save_settings(settings)
    print(f"Removed from {SETTINGS}.")


def cmd_set_key(_):
    key = (getpass.getpass("Anthropic API key: ") if sys.stdin.isatty() else sys.stdin.read()).strip()
    if not key:
        sys.exit("No key given.")
    STATE.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(key)
    KEY_FILE.chmod(0o600)
    print(f"Saved to {KEY_FILE}. Run `approve-all check` to try it.")


def cmd_check(_):
    if not api_key():
        sys.exit("No API key. Put it in .env next to this script: see .env.example.")
    ask = "Should I name the file notes.md or notes.txt? I recommend notes.md."
    verdict = ask_model(build_prompt(ask, [], [], "check"))
    if not verdict:
        sys.exit("The review failed. See `approve-all log`.")
    print(f"{MODEL}: {verdict.get('action')}: {verdict.get('message') or verdict.get('reason')}")
    print(f"spent so far: ${spent():.4f} of ${BUDGET:g} (estimate)")


def cmd_pause(_):
    STATE.mkdir(parents=True, exist_ok=True)
    PAUSED.touch()
    print("Paused. No session gets auto-answered until `approve-all resume`.")


def cmd_resume(_):
    PAUSED.unlink(missing_ok=True)
    print("Resumed.")


# --- scan / status -----------------------------------------------------------

def live_sessions():
    live = {}
    for path in glob.glob(str(REGISTRY / "*.json")):
        try:
            data = json.loads(Path(path).read_text())
            os.kill(data["pid"], 0)
        except (ValueError, KeyError, TypeError, OSError):
            continue
        live[data.get("sessionId")] = data
    return live


def desktop_sessions():
    found = {}
    for path in glob.glob(str(DESKTOP / "*/*/local_*.json")):
        try:
            data = json.loads(Path(path).read_text())
            found[data.get("cliSessionId")] = data
        except (ValueError, OSError, AttributeError):
            continue
    return found


def cmd_scan(args):
    live, desktop = live_sessions(), desktop_sessions()
    cutoff = time.time() - args.hours * 3600
    waiting = 0
    paths = [p for p in glob.glob(str(PROJECTS / "*/*.jsonl")) if os.path.getmtime(p) >= cutoff]
    found = []
    for path in sorted(paths, key=os.path.getmtime, reverse=True):
        session_id = Path(path).stem
        info, meta = live.get(session_id, {}), desktop.get(session_id, {})
        if info.get("status") == "busy" or meta.get("isArchived"):
            continue
        rows, _ = read_stopped(path, 1_500_000)
        entrypoint = next((r["entrypoint"] for r in reversed(rows) if r.get("entrypoint")), None)
        if "*" not in ENTRYPOINTS and entrypoint not in ENTRYPOINTS:
            continue
        found.append((session_id, info, meta, rows))

    def inspect(item):
        rows = item[3]
        cwd = next((r["cwd"] for r in reversed(rows) if r.get("cwd")), "")
        try:
            return decide(read_turn(rows), rows, cwd)
        except Exception as e:  # one odd transcript shouldn't hide the other sessions
            log(event="error", error=f"scan: {e!r}"[:400])
            return None

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        decisions = list(pool.map(inspect, found))
    for (session_id, info, meta, _), decision in zip(found, decisions):
        if not decision:
            continue
        waiting += 1
        title = meta.get("title") or info.get("name") or session_id
        state = "idle" if info else "no process"
        print(f"{title}  ({state})")
        print(f"  asks:  {' '.join(decision['ask'].split())[:160]}")
        if "reason" in decision:
            print(f"  needs you: {decision['reason']}")
        else:
            reply = " ".join(decision["reply"].split("\n", 1)[-1].split())
            print(f"  would say: {reply[:160]}")
            if decision.get("why"):
                print(f"  because: {decision['why']}")
        if meta.get("sessionId"):
            print(f"  open:  claude://claude.ai/epitaxy/{meta['sessionId']}")
    print(f"{waiting} waiting (last {args.hours:g}h).")


def cmd_log(args):
    if not LOG.exists():
        print("Nothing logged yet.")
        return
    try:
        lines = LOG.read_text(errors="ignore").splitlines()[-args.n:]
    except OSError as e:
        sys.exit(f"Can't read {LOG}: {e}")
    for line in lines:
        try:
            e = json.loads(line)
            folder = os.path.basename(e.get("cwd") or "")
        except (ValueError, AttributeError, TypeError):
            continue
        detail = e.get("ask") or e.get("tool") or e.get("error") or ""
        reason = f" [{e['reason']}]" if e.get("reason") else ""
        print(f"{e.get('t', '?')} {folder}: {e.get('action', e.get('event'))}{reason}: {' '.join(str(detail).split())[:120]}")
        if e.get("why"):
            print(f"  because: {e['why']}")


def reviewer_status():
    if not importlib.util.find_spec("anthropic"):
        return "off, no anthropic SDK (run this through uv)"
    return f"{MODEL} at {EFFORT} effort" if can_review() else "off, rules only"


def cmd_status(_):
    try:
        stop = load_settings().get("hooks", {}).get("Stop", [])
        installed = "yes" if any(is_ours(h) for group in stop for h in hooks_in(group)) else "no"
    except SystemExit as e:
        installed = f"unknown. {e}"
    print(f"installed: {installed}")
    print(f"paused:    {'yes' if PAUSED.exists() else 'no'}")
    print(f"reviewer:  {reviewer_status()}")
    print(f"spent:     ${spent():.2f} of ${BUDGET:g} (estimate)")
    print(f"log:       {LOG}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    for name, handler in [("hook", cmd_hook), ("install", cmd_install), ("uninstall", cmd_uninstall),
                          ("set-key", cmd_set_key), ("check", cmd_check),
                          ("pause", cmd_pause), ("resume", cmd_resume), ("status", cmd_status)]:
        sub.add_parser(name).set_defaults(run=handler)
    scan = sub.add_parser("scan")
    scan.add_argument("--hours", type=float, default=24)
    scan.set_defaults(run=cmd_scan)
    show = sub.add_parser("log")
    show.add_argument("-n", type=int, default=20)
    show.set_defaults(run=cmd_log)
    args = parser.parse_args()
    args.run(args)


if __name__ == "__main__":
    main()
